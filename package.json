{
  "name": "sugiero",
  "version": "3.0.0",
  "description": "Get search suggestions based on a partial search term",
  "keywords": [
    "search",
    "suggestions"
  ],
  "license": "MIT",
  "author": "Alberto Rico",
  "contributors": [
    {
      "name": "ChunkyProgrammer",
      "url": "https://github.com/ChunkyProgrammer"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alrico88/sugiero"
  },
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test run",
    "lint": "vp check --fix",
    "coverage": "vp test run --coverage",
    "prepublishOnly": "pnpm run build",
    "test:live": "LIVE=1 vp test run tests/live.test.ts"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "~7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.14.0"
}
